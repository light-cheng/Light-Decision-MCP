{
  "name": "light-decision-mcp",
  "version": "0.1.0",
  "description": "Multi-backend Decision MCP & Magpie plugin for System One models (Gemini Decision, Jev, Perplexity & local models) with hardware-aware setup wizard.",
  "type": "module",
  "main": "./src/magpie-plugin.mjs",
  "exports": {
    ".": "./src/magpie-plugin.mjs",
    "./core": "./src/core/tools.mjs"
  },
  "bin": {
    "light-decision-mcp": "bin/cli.mjs",
    "light-decision-mcp-stdio": "bin/stdio.mjs"
  },
  "files": [
    "src",
    "bin",
    "page",
    "assets/icon.png",
    "README.md",
    "README.zh-CN.md",
    "SPEC.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "magpie",
    "magpie-plugin",
    "opencode-plugin",
    "decision-model",
    "system-one",
    "gemini-decision",
    "typesafe-jev",
    "perplexity-decisions",
    "opendecider",
    "local-ai"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/light-cheng/Light-Decision-MCP.git"
  },
  "homepage": "https://github.com/light-cheng/Light-Decision-MCP#readme",
  "bugs": {
    "url": "https://github.com/light-cheng/Light-Decision-MCP/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.mjs\"",
    "ui": "node ./bin/cli.mjs ui",
    "doctor": "node ./bin/cli.mjs doctor",
    "recommend": "node ./bin/cli.mjs recommend",
    "setup": "node ./bin/cli.mjs setup"
  },
  "magpie": {
    "icon": "data:image/png;base64,",
    "page": {
      "title": "Light Decision",
      "titles": {
        "zh": "Light Decision 决策配置",
        "zh-TW": "Light Decision 決策設定"
      },
      "file": "page/index.html",
      "icon": "page/icon.png"
    },
    "permissions": [],
    "options": {
      "routingMode": "",
      "defaultBackend": "",
      "defaultModel": "",
      "fallbackBackend": "",
      "fallbackOnNotConfigured": null,
      "maxDataDestination": "",
      "timeoutMs": null,
      "primaryTimeoutMs": null,
      "fallbackTimeoutMs": null,
      "gatewayUrl": ""
    }
  }
}
